    "Sin días marcados, todos los días. El aviso solo nombra el objetivo, nunca tus datos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With no days selected, every day. The notification only names the goal, never your data."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem dias marcados, todos os dias. O aviso só menciona a meta, nunca seus dados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans jour sélectionné, tous les jours. La notification nomme seulement l’objectif, jamais tes données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza giorni selezionati, tutti i giorni. L’avviso nomina solo l’obiettivo, mai i tuoi dati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan valda dagar gäller alla dagar. Aviseringen nämner bara målet, aldrig dina data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden valgte dage gælder alle dage. Notifikationen nævner kun målet, aldrig dine data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择日期时为每天。通知只会提及目标名称，绝不包含你的数据。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दिन न चुनने पर हर दिन। सूचना में सिर्फ़ लक्ष्य का नाम होता है, आपका डेटा कभी नहीं।"
          }
        }
      }
    },
