          }
        }
      }
    },
    "Los objetivos se guardan solo en este iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goals are stored only on this iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As metas ficam salvas apenas neste iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les objectifs sont enregistrés uniquement sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli obiettivi vengono salvati solo su questo iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Målen sparas bara på den här iPhonen."
          }
        },
        "da": {
