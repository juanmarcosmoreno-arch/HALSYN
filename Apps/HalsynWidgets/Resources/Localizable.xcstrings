            "value": "Questa settimana hai raggiunto il tuo obiettivo in tutte le notti registrate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I veckan nådde du ditt mål alla registrerade nätter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I denne uge nåede du dit mål alle registrerede nætter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周你在所有有记录的夜晚都达到了目标。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस हफ़्ते आपने दर्ज की गई हर रात अपना लक्ष्य पूरा किया।"
          }
        }
      }
    },
    "Esta semana te faltaron %@ respecto a tu objetivo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week you were %@ short of your goal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana faltaram %@ para a sua meta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette semaine, il t’a manqué %@ par rapport à ton objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa settimana ti sono mancati %@ rispetto al tuo obiettivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I veckan saknades %@ till ditt mål."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I denne uge manglede du %@ i forhold til dit mål."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周你距离目标还差 %@。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस हफ़्ते आप अपने लक्ष्य से %@ पीछे रहे।"
          }
        }
      }
    },
