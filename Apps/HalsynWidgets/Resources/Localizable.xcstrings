    "7.783 pruebas en 8 laboratorios de EE. UU. (2014–2015), adultos de 20 a 79 años sin enfermedad cardiovascular ni EPOC conocidas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7,783 tests at 8 US labs (2014–2015), adults aged 20 to 79 with no known cardiovascular disease or COPD."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "7.783 testes em 8 laboratórios dos EUA (2014–2015), adultos de 20 a 79 anos sem doença cardiovascular nem DPOC conhecidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 783 tests dans 8 laboratoires aux États-Unis (2014–2015), adultes de 20 à 79 ans sans maladie cardiovasculaire ni BPCO connues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "7.783 test in 8 laboratori negli USA (2014–2015), adulti tra 20 e 79 anni senza malattie cardiovascolari né BPCO note."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "7 783 tester på 8 laboratorier i USA (2014–2015), vuxna 20–79 år utan känd hjärt-kärlsjukdom eller KOL."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "7.783 test på 8 laboratorier i USA (2014–2015), voksne på 20 til 79 år uden kendt hjerte-kar-sygdom eller KOL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在美国 8 个实验室完成的 7,783 次测试（2014–2015），受试者为 20 至 79 岁、无已知心血管疾病或慢阻肺的成年人。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमेरिका की 8 लैब में 7,783 टेस्ट (2014–2015), 20 से 79 वर्ष के ऐसे वयस्क जिन्हें कोई ज्ञात हृदय रोग या COPD नहीं था।"
          }
        }
      }
    },
