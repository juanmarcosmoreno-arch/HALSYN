    "Calculados a partir de la ruta GPS; pueden diferir ligeramente de la distancia total de Apple Health.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated from the GPS route; they may differ slightly from the total distance in Apple Health."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculados a partir do percurso GPS; podem diferir um pouco da distância total do Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculés à partir du parcours GPS ; ils peuvent différer légèrement de la distance totale d’Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolati dal percorso GPS; possono differire leggermente dalla distanza totale di Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beräknade utifrån GPS-rutten; de kan skilja sig något från den totala distansen i Apple Health."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beregnet ud fra GPS-ruten; de kan afvige lidt fra den samlede distance i Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据 GPS 路线计算，可能与 Apple Health 中的总距离略有差异。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS रूट से गणना की गई; ये Apple Health की कुल दूरी से थोड़े अलग हो सकते हैं।"
          }
        }
      }
    },
