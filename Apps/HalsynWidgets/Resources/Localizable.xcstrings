    "Tras dormir %@ o más, tu FC en reposo fue de %@ de media; tras dormir menos, de %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After sleeping %@ or more, your resting HR averaged %@; after less sleep, %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de dormir %@ ou mais, sua FC em repouso foi de %@ em média; depois de dormir menos, de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir dormi %@ ou plus, ta FC au repos était de %@ en moyenne ; après moins de sommeil, de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver dormito %@ o più, la tua FC a riposo è stata in media di %@; dopo aver dormito meno, di %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter att du sovit %@ eller mer var din vilopuls i snitt %@; efter mindre sömn %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter at du har sovet %@ eller mere, var din hvilepuls i gennemsnit %@; efter mindre søvn %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠 %@ 或以上后，你的静息心率平均为 %@；睡得较少时为 %@。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ या उससे ज़्यादा सोने के बाद आपकी आराम की हृदय गति औसतन %@ रही; कम सोने के बाद %@।"
          }
        }
      }
    },
