    "Al día siguiente de %@ de ejercicio o más, tu FC en reposo fue de %@ de media; tras días más tranquilos, de %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day after %@ or more of exercise, your resting HR averaged %@; after quieter days, %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No dia seguinte a %@ ou mais de exercício, sua FC em repouso foi de %@ em média; após dias mais tranquilos, de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lendemain de %@ d’exercice ou plus, ta FC au repos était de %@ en moyenne ; après des journées plus calmes, de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giorno dopo %@ o più di esercizio, la tua FC a riposo è stata in media di %@; dopo giorni più tranquilli, di %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen efter %@ träning eller mer var din vilopuls i snitt %@; efter lugnare dagar %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen efter %@ motion eller mere var din hvilepuls i gennemsnit %@; efter roligere dage %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锻炼 %@ 或以上后的第二天，你的静息心率平均为 %@；较轻松的日子之后为 %@。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ या उससे ज़्यादा व्यायाम के अगले दिन आपकी आराम की हृदय गति औसतन %@ रही; हल्के दिनों के बाद %@।"
          }
        }
      }
    },
    "Al día siguiente de %@ de ejercicio o más, tu HRV fue de %@ de media; tras días más tranquilos, de %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day after %@ or more of exercise, your HRV averaged %@; after quieter days, %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No dia seguinte a %@ ou mais de exercício, sua HRV foi de %@ em média; após dias mais tranquilos, de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lendemain de %@ d’exercice ou plus, ta HRV était de %@ en moyenne ; après des journées plus calmes, de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giorno dopo %@ o più di esercizio, la tua HRV è stata in media di %@; dopo giorni più tranquilli, di %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen efter %@ träning eller mer var din HRV i snitt %@; efter lugnare dagar %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen efter %@ motion eller mere var din HRV i gennemsnit %@; efter roligere dage %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锻炼 %@ 或以上后的第二天，你的 HRV 平均为 %@；较轻松的日子之后为 %@。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ या उससे ज़्यादा व्यायाम के अगले दिन आपकी HRV औसतन %@ रही; हल्के दिनों के बाद %@।"
          }
        }
      }
    },
