            "value": "बदलाव अपने-आप Apple Watch पर भेजे जाते हैं।"
          }
        }
      }
    },
    "Los nombres de los módulos son palabras suecas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The module names are Swedish words."
          }
        },
        "pt-BR": {
