    "El VO₂ máx. del Apple Watch es una estimación submáxima; la tabla se obtuvo con pruebas de laboratorio.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch VO₂ max is a submaximal estimate; the table comes from lab tests."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VO₂ máx. do Apple Watch é uma estimativa submáxima; a tabela foi obtida com testes de laboratório."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La VO₂ max. de l’Apple Watch est une estimation sous-maximale ; le tableau provient de tests en laboratoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il VO₂ max di Apple Watch è una stima submassimale; la tabella è stata ottenuta con test di laboratorio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VO₂ max från Apple Watch är en submaximal uppskattning; tabellen bygger på laboratorietester."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "VO₂ max fra Apple Watch er et submaksimalt estimat; tabellen er baseret på laboratorietest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 的 VO₂ max 是次最大强度估算值；该表格数据来自实验室测试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch का VO₂ max एक सबमैक्सिमल अनुमान है; तालिका लैब टेस्ट से बनाई गई थी।"
          }
        }
      }
    },
    "El botón Vuelta del reloj marca vueltas manuales en cualquier momento.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The watch's Lap button marks manual laps at any time."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão Volta do relógio marca voltas manuais a qualquer momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton Tour de la montre marque des tours manuels à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante Giro dell’orologio segna giri manuali in qualsiasi momento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klockans Varv-knapp markerar manuella varv när som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Urets Omgang-knap markerer manuelle omgange når som helst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时按手表上的“分段”按钮即可手动分段。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी का लैप बटन किसी भी समय मैन्युअल लैप मार्क करता है।"
          }
        }
      }
    },
    "El gráfico aparece al empezar a moverte": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chart appears once you start moving"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gráfico aparece quando você começa a se mover"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le graphique apparaît dès que tu commences à bouger"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il grafico appare quando inizi a muoverti"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagrammet visas när du börjar röra dig"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafen vises, når du begynder at bevæge dig"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始移动后显示图表"
          }
