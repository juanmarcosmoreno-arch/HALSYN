    "Local-first: tus datos se procesan en el dispositivo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local-first: your data is processed on your device."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Local-first: seus dados são processados no dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Local-first : tes données sont traitées sur l’appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Local-first: i tuoi dati vengono elaborati sul dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Local-first: dina data behandlas på enheten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Local-first: dine data behandles på enheden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地优先：你的数据在设备上处理。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकल-फ़र्स्ट: आपका डेटा डिवाइस पर ही प्रोसेस होता है।"
          }
        }
      }
    },
