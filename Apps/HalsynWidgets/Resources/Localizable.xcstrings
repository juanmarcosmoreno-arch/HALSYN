    "Tu sueño es más largo en la noche que termina el %@ y más corto en la que termina el %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sleep longest on the night ending %@ morning and shortest on the night ending %@ morning."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você dorme mais na noite que termina na manhã de %@ e menos na que termina na manhã de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dors le plus longtemps la nuit qui se termine le %@ matin et le moins longtemps celle qui se termine le %@ matin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormi più a lungo la notte che finisce %@ mattina e meno a lungo quella che finisce %@ mattina."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sover längst natten mot %@ och kortast natten mot %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sover længst natten til %@ og kortest natten til %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在%@早晨前的那一晚睡得最久，在%@早晨前的那一晚睡得最短。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की सुबह खत्म होने वाली रात आपकी नींद सबसे लंबी होती है, और %@ की सुबह खत्म होने वाली रात सबसे छोटी।"
          }
        }
      }
    },
    "Tu valor es más alto que el percentil %@ de %@: por encima de lo que cubre la tabla.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your value is higher than percentile %@ for %@: above what the table covers."
