        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वास्थ्य ने आपकी जन्मतिथि या लिंग शेयर नहीं किया है। आप इन्हें यहां लिख सकते हैं।"
          }
        }
      }
    },
