    "Falta una FC en reposo válida: se usa el porcentaje de la FC máxima.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No valid resting HR: using percentage of max HR instead."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta uma FC em repouso válida: é usada a porcentagem da FC máxima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune FC au repos valide : le pourcentage de la FC max. est utilisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca una FC a riposo valida: viene usata la percentuale della FC max."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Giltig vilopuls saknas: procent av maxpulsen används i stället."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der mangler en gyldig hvilepuls: procent af maks. puls bruges i stedet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少有效的静息心率：改用最大心率百分比。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मान्य आराम की हृदय गति नहीं है: अधिकतम हृदय गति का प्रतिशत इस्तेमाल हो रहा है।"
          }
        }
      }
    },
