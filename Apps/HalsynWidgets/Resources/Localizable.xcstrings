    "Elige uno de los sugeridos o crea el tuyo. El progreso se calcula con tus datos de Apple Health.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one of the suggestions or create your own. Progress is calculated from your Apple Health data."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma das sugestões ou crie a sua. O progresso é calculado com seus dados do Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis l’une des suggestions ou crée le tien. La progression est calculée à partir de tes données Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli uno dei suggerimenti o crea il tuo. I progressi sono calcolati con i tuoi dati di Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett av förslagen eller skapa ett eget. Framstegen beräknas utifrån dina data i Apple Health."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et af forslagene, eller opret dit eget. Fremskridtet beregnes ud fra dine data i Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从建议中选择一个，或创建你自己的目标。进度根据你的 Apple Health 数据计算。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझावों में से एक चुनें या अपना बनाएं। प्रगति की गणना आपके Apple Health डेटा से की जाती है।"
          }
        }
      }
    },
