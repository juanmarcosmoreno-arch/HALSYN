    "Disponible al conectar Apple Health: en modo demo no se guardan valores de ejemplo como tuyos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available once you connect Apple Health: in demo mode, sample values aren't saved as yours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponível ao conectar o Apple Health: no modo demo, valores de exemplo não são salvos como seus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible une fois Apple Health connecté : en mode démo, les valeurs d’exemple ne sont pas enregistrées comme les tiennes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibile collegando Apple Health: in modalità demo i valori di esempio non vengono salvati come tuoi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillgängligt när du ansluter Apple Health: i demoläge sparas inte exempelvärden som dina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgængelig, når du forbinder Apple Health: i demotilstand gemmes eksempelværdier ikke som dine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Apple Health 后可用：演示模式下不会将示例数值保存为你的数据。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health कनेक्ट करने पर उपलब्ध: डेमो मोड में उदाहरण मान आपके डेटा के रूप में सेव नहीं होते।"
          }
        }
      }
    },
