    "¿Eliminar este objetivo?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this goal?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar esta meta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cet objectif ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questo obiettivo?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera det här målet?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet dette mål?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此目标？"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लक्ष्य हटाएं?"
          }
        }
      }
    },
    "¿Faltan datos? Comprueba en Ajustes › Salud › Acceso a datos y dispositivos › HÅLSYN qué datos compartes, y que llevas el Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing data? Check which data you share in Settings › Health › Data Access & Devices › HÅLSYN, and make sure you're wearing your Apple Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam dados? Confira em Ajustes › Saúde › Acesso a Dados e Dispositivos › HÅLSYN quais dados você compartilha e se está usando o Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des données manquent ? Vérifie dans Réglages › Santé › Accès aux données et appareils › HÅLSYN quelles données tu partages, et que tu portes bien ton Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano dei dati? Controlla in Impostazioni › Salute › Accesso ai dati e dispositivi › HÅLSYN quali dati condividi e assicurati di indossare l’Apple Watch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saknas data? Kontrollera i Inställningar › Hälsa › Dataåtkomst och enheter › HÅLSYN vilka data du delar, och att du bär din Apple Watch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangler der data? Tjek under Indstillinger › Sundhed › Dataadgang og enheder › HÅLSYN, hvilke data du deler, og at du har dit Apple Watch på."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少数据？请在“设置 › 健康 › 数据访问与设备 › HÅLSYN”中检查你共享了哪些数据，并确认你佩戴着 Apple Watch。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा नहीं दिख रहा? सेटिंग्ज़ › स्वास्थ्य › डेटा एक्सेस और डिवाइस › HÅLSYN में देखें कि आप कौन-सा डेटा शेयर कर रहे हैं, और यह भी कि आपने Apple Watch पहनी है।"
          }
        }
      }
    },
