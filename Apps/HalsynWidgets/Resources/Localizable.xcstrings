          "stringUnit": {
            "state": "translated",
            "value": "फ़िनिश"
          }
        }
      }
    },
    "Llegarás a la meta en %lld semanas, subiendo como mucho un 10 por ciento por semana.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll reach the target in %lld weeks, increasing by no more than 10 percent per week."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você chegará à meta em %lld semanas, aumentando no máximo 10 por cento por semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu atteindras la cible en %lld semaines, en augmentant de 10 pour cent maximum par semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggiungerai il traguardo in %lld settimane, aumentando al massimo del 10 per cento a settimana."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du når målnivån om %lld veckor, med en ökning på högst 10 procent per vecka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du når målet om %lld uger med en stigning på højst 10 procent om ugen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将在 %lld 周内达到目标，每周增幅不超过百分之十。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %lld हफ़्तों में अंतिम लक्ष्य तक पहुंचेंगे, हर हफ़्ते अधिकतम 10 प्रतिशत बढ़ाते हुए।"
          }
        }
      }
    },
    "Lleva el Apple Watch al dormir (o usa otra app que guarde el sueño en Salud) para ver tus noches aquí.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wear your Apple Watch to sleep (or use another app that saves sleep to Health) to see your nights here."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Apple Watch para dormir (ou outro app que salve o sono no Saúde) para ver suas noites aqui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Porte ton Apple Watch pour dormir (ou utilise une autre app qui enregistre le sommeil dans Santé) pour voir tes nuits ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indossa Apple Watch mentre dormi (o usa un’altra app che salvi il sonno in Salute) per vedere qui le tue notti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bär Apple Watch när du sover (eller använd en annan app som sparar sömn i Hälsa) för att se dina nätter här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bær dit Apple Watch, når du sover (eller brug en anden app, der gemmer søvn i Sundhed), for at se dine nætter her."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡觉时佩戴 Apple Watch（或使用其他会将睡眠存入“健康”的 App），即可在这里查看你的夜晚。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी रातें यहां देखने के लिए सोते समय Apple Watch पहनें (या कोई और ऐप इस्तेमाल करें जो नींद को स्वास्थ्य में सेव करता हो)।"
          }
        }
      }
    },
    "Lleva el Apple Watch al dormir para ver tu descanso.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wear your Apple Watch to sleep to see your rest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Apple Watch para dormir e veja seu descanso."
          }
        },
        "fr": {
