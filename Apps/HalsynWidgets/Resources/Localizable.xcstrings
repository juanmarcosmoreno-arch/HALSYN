    "No se pudo abrir HÅLSYN en el reloj. Comprueba que está instalada y que el reloj está desbloqueado.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open HÅLSYN on your watch. Make sure it's installed and your watch is unlocked."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o HÅLSYN no relógio. Verifique se ele está instalado e se o relógio está desbloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir HÅLSYN sur la montre. Vérifie que l’app est installée et que la montre est déverrouillée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire HÅLSYN sull’orologio. Verifica che sia installata e che l’orologio sia sbloccato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att öppna HÅLSYN på klockan. Kontrollera att appen är installerad och att klockan är upplåst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN kunne ikke åbnes på uret. Tjek, at appen er installeret, og at uret er låst op."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在手表上打开 HÅLSYN。请确认已安装该 App，且手表已解锁。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी पर HÅLSYN नहीं खुल सका। जाँचें कि ऐप इंस्टॉल है और घड़ी अनलॉक है।"
          }
        }
      }
    },
