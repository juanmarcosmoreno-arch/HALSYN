            "state": "translated",
            "value": "Porte ton Apple Watch pour dormir afin de voir ton repos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indossa Apple Watch mentre dormi per vedere il tuo riposo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bär Apple Watch när du sover för att se din vila."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bær dit Apple Watch, når du sover, for at se din hvile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡觉时佩戴 Apple Watch，即可查看你的休息情况。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना आराम देखने के लिए सोते समय Apple Watch पहनें।"
          }
        }
      }
    },
    "Llevas %@ min de ejercicio en los últimos 7 días (referencia: 150).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've done %@ min of exercise in the last 7 days (reference: 150)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você fez %@ min de exercício nos últimos 7 dias (referência: 150)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as fait %@ min d’exercice sur les 7 derniers jours (référence : 150)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
