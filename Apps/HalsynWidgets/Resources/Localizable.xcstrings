    "Salud no ha compartido tu fecha de nacimiento ni tu sexo. Puedes escribirlos aquí.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health hasn't shared your date of birth or sex. You can enter them here."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Saúde não compartilhou sua data de nascimento nem seu sexo. Você pode informá-los aqui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Santé n’a pas partagé ta date de naissance ni ton sexe. Tu peux les saisir ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salute non ha condiviso la tua data di nascita né il tuo sesso. Puoi inserirli qui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälsa har inte delat ditt födelsedatum eller kön. Du kan ange dem här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sundhed har ikke delt din fødselsdato eller dit køn. Du kan angive dem her."
