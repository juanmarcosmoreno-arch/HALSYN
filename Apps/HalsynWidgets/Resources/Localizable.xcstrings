            "value": "150 min गतिविधि"
          }
        }
      }
    },
    "150 min semanales de actividad moderada es la recomendación de la OMS para adultos; 7–9 h de sueño, la recomendación general para adultos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "150 min of moderate activity per week is the WHO recommendation for adults; 7–9 h of sleep is the general recommendation for adults."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "150 min semanais de atividade moderada é a recomendação da OMS para adultos; 7–9 h de sono, a recomendação geral para adultos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "150 min d’activité modérée par semaine, c’est la recommandation de l’OMS pour les adultes ; 7 à 9 h de sommeil, la recommandation générale pour les adultes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "150 min settimanali di attività moderata sono la raccomandazione dell’OMS per gli adulti; 7–9 h di sonno, la raccomandazione generale per gli adulti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "150 min måttlig aktivitet per vecka är WHO:s rekommendation för vuxna; 7–9 h sömn är den allmänna rekommendationen för vuxna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "150 min moderat aktivitet om ugen er WHO’s anbefaling for voksne; 7–9 t søvn er den generelle anbefaling for voksne."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周 150 分钟中等强度活动是世界卫生组织对成年人的建议；每晚 7–9 小时睡眠是对成年人的一般建议。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वयस्कों के लिए WHO की सिफ़ारिश हर हफ़्ते 150 min मध्यम गतिविधि है; वयस्कों के लिए सामान्य सिफ़ारिश 7–9 h नींद है।"
          }
        }
      }
    },
