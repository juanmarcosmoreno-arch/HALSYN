    "Durante la carrera se pasa de una a otra deslizando en horizontal. Hasta 4 pantallas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During a run, swipe sideways to move between them. Up to 4 screens."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a corrida, deslize para os lados para passar de uma para outra. Até 4 telas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant la course, balaie horizontalement pour passer de l’un à l’autre. Jusqu’à 4 écrans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la corsa scorri in orizzontale per passare dall’una all’altra. Fino a 4 schermate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under passet sveper du i sidled för att byta mellan dem. Upp till 4 skärmar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Under løbeturen skifter du mellem dem ved at stryge til siden. Op til 4 skærme."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跑步时左右轻扫即可切换。最多 4 个界面。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रन के दौरान एक से दूसरी पर जाने के लिए बगल में स्वाइप करें। अधिकतम 4 स्क्रीन।"
          }
        }
      }
    },
