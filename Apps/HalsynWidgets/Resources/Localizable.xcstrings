    "«Tiempo dormido» es la parte del periodo entre dormirte y despertarte que pasaste dormido.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«Time asleep» is the part of the time between falling asleep and waking up that you spent asleep."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Tempo dormindo» é a parte do período entre adormecer e acordar que você passou dormindo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Temps endormi» correspond à la part de la période entre l’endormissement et le réveil que tu as passée à dormir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Tempo di sonno» è la parte del periodo tra quando ti addormenti e quando ti svegli che hai trascorso dormendo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sovtid» är den del av tiden mellan att du somnade och vaknade som du faktiskt sov."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "«Søvntid» er den del af perioden mellem at falde i søvn og vågne, som du faktisk sov."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“睡眠时间占比”是指从入睡到醒来这段时间中你实际睡着的部分。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "«सोने का समय» सोने और जागने के बीच की अवधि का वह हिस्सा है जो आपने सोते हुए बिताया।"
          }
        }
      }
    },
