      }
    },
    "Observado en %lld días. Es una asociación en tus datos, no prueba que una cosa cause la otra.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observed over %lld days. This is an association in your data; it doesn't prove that one thing causes the other."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Observado em %lld dias. É uma associação nos seus dados, não prova que uma coisa cause a outra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Observé sur %lld jours. C’est une association dans tes données, pas la preuve que l’un cause l’autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osservato in %lld giorni. È un’associazione nei tuoi dati, non dimostra che una cosa causi l’altra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Observerat under %lld dagar. Det är ett samband i dina data, inte ett bevis för att det ena orsakar det andra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Observeret over %lld dage. Det er en sammenhæng i dine data, ikke et bevis for, at det ene forårsager det andet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 %lld 天的观察。这只是你数据中的关联，并不能证明其中一方导致了另一方。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld दिनों में देखा गया। यह आपके डेटा में एक संबंध है, इससे यह साबित नहीं होता कि एक चीज़ दूसरी की वजह है।"
          }
        }
      }
    },
