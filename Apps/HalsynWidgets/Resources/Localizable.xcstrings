          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulso radial contado manualmente por 30 s (×2), sentado após cerca de 4 minutos de repouso; uma única medição por pessoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
