    "Los cambios se envían al Apple Watch automáticamente.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes are sent to your Apple Watch automatically."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são enviadas ao Apple Watch automaticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications sont envoyées automatiquement à l’Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche vengono inviate automaticamente all’Apple Watch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar skickas automatiskt till din Apple Watch."
          }
        },
        "da": {
