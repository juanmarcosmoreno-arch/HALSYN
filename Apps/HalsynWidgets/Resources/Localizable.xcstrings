        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuter med en intensitet motsvarande en rask promenad eller högre, enligt Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutter med en intensitet svarende til en rask gåtur eller højere, ifølge Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
