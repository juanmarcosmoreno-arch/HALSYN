    "Hacen falta tu HRV o tu FC en reposo y unos días de historial para estimarla.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs your HRV or resting HR and a few days of history to estimate it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso ter sua HRV ou sua FC em repouso e alguns dias de histórico para estimá-la."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta HRV ou ta FC au repos et quelques jours d’historique sont nécessaires pour l’estimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono la tua HRV o la tua FC a riposo e qualche giorno di storico per stimarla."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din HRV eller vilopuls och några dagars historik behövs för att uppskatta den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din HRV eller hvilepuls og nogle dages historik er nødvendige for at estimere den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你的 HRV 或静息心率以及几天的历史数据才能估算。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसका अनुमान लगाने के लिए आपकी HRV या आराम की हृदय गति और कुछ दिनों का इतिहास चाहिए।"
          }
        }
      }
    },
    "Haces más ejercicio los %@ y menos los %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You exercise the most on %@ and the least on %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia em que você mais se exercita é %@, e o que menos se exercita, %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fais le plus d’exercice le %@ et le moins le %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giorno in cui fai più esercizio è %@; quello in cui ne fai meno, %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den veckodag du tränar mest är %@ och den du tränar minst är %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ugedag, du dyrker mest motion, er %@, og den, du dyrker mindst, er %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在%@锻炼最多，在%@锻炼最少。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %@ को सबसे ज़्यादा और %@ को सबसे कम व्यायाम करते हैं।"
          }
        }
      }
    },
