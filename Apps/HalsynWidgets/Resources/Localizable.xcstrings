    "Muestra de conveniencia de EE. UU.; poblaciones nórdicas suelen tener valores más altos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "US convenience sample; Nordic populations tend to have higher values."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amostra de conveniência dos EUA; populações nórdicas costumam ter valores mais altos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échantillon de convenance américain ; les populations nordiques ont souvent des valeurs plus élevées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Campione di convenienza USA; le popolazioni nordiche tendono ad avere valori più alti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekvämlighetsurval från USA; nordiska befolkningar har ofta högre värden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekvemmelighedsstikprøve fra USA; nordiske befolkninger har ofte højere værdier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国的便利样本；北欧人群的数值通常更高。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमेरिका का सुविधा-आधारित सैंपल; नॉर्डिक आबादी में मान अक्सर ज़्यादा होते हैं।"
          }
        }
      }
    },
    "Muestra el desglose de la puntuación": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the score breakdown"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o detalhamento da pontuação"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le détail du score"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il dettaglio del punteggio"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar poängens uppdelning"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser opdelingen af scoren"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示评分明细"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कोर का ब्रेकडाउन दिखाता है"
          }
        }
      }
    },
    "Muestra representativa de EE. UU. (NHANES 1999–2008), 14.200 adultos; excluye embarazo, infección probable, pulso irregular, tiroides alterada y fármacos que cambian la frecuencia cardíaca (p. ej., betabloqueantes).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Representative US sample (NHANES 1999–2008), 14,200 adults; excludes pregnancy, likely infection, irregular pulse, abnormal thyroid and medications that change heart rate (e.g., beta-blockers)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amostra representativa dos EUA (NHANES 1999–2008), 14.200 adultos; exclui gravidez, infecção provável, pulso irregular, tireoide alterada e medicamentos que alteram a frequência cardíaca (p. ex., betabloqueadores)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échantillon représentatif des États-Unis (NHANES 1999–2008), 14 200 adultes ; exclut la grossesse, une infection probable, un pouls irrégulier, une thyroïde perturbée et les médicaments qui modifient la fréquence cardiaque (p. ex. bêtabloquants)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Campione rappresentativo USA (NHANES 1999–2008), 14.200 adulti; esclude gravidanza, probabile infezione, polso irregolare, tiroide alterata e farmaci che modificano la frequenza cardiaca (ad es. betabloccanti)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Representativt urval från USA (NHANES 1999–2008), 14 200 vuxna; exkluderar graviditet, trolig infektion, oregelbunden puls, avvikande sköldkörtel och läkemedel som påverkar pulsen (t.ex. betablockerare)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Repræsentativ stikprøve fra USA (NHANES 1999–2008), 14.200 voksne; udelukker graviditet, sandsynlig infektion, uregelmæssig puls, ændret skjoldbruskkirtel og medicin, der påvirker pulsen (f.eks. betablokkere)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国代表性样本（NHANES 1999–2008），14,200 名成年人；排除了怀孕、可能感染、脉搏不规则、甲状腺异常以及服用影响心率药物（如 β 受体阻滞剂）的人。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमेरिका का प्रतिनिधि सैंपल (NHANES 1999–2008), 14,200 वयस्क; इसमें गर्भावस्था, संभावित संक्रमण, अनियमित नब्ज़, थायरॉइड में गड़बड़ी और हृदय गति बदलने वाली दवाओं (जैसे बीटा-ब्लॉकर) वाले लोग शामिल नहीं हैं।"
          }
        }
      }
    },
