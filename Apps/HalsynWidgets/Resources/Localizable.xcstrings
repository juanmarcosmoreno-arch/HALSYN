    "Sueño, recuperación y equilibrio esfuerzo-descanso.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep, recovery and effort–rest balance."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono, recuperação e equilíbrio entre esforço e descanso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommeil, récupération et équilibre effort-repos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonno, recupero ed equilibrio sforzo-riposo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sömn, återhämtning och balans mellan ansträngning och vila."
          }
        },
        "da": {
          "stringUnit": {
