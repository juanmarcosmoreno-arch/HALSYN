    "Media y variación de los horarios. Horarios estables suelen ayudar a dormir mejor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average and variation of your times. Steady times usually help you sleep better."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Média e variação dos horários. Horários estáveis costumam ajudar a dormir melhor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyenne et variation des horaires. Des horaires réguliers aident souvent à mieux dormir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Media e variazione degli orari. Orari regolari di solito aiutano a dormire meglio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snitt och variation för tiderna. Jämna tider brukar hjälpa dig att sova bättre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemsnit og variation af tidspunkterne. Faste tidspunkter hjælper ofte til bedre søvn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作息时间的平均值和波动。作息稳定通常有助于睡得更好。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय का औसत और उतार-चढ़ाव। नियमित समय अक्सर बेहतर नींद में मदद करता है।"
          }
        }
      }
    },
