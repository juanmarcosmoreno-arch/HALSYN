{
  "sourceLanguage": "es",
  "strings": {
    "NSHealthShareUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN lee tus datos de Apple Health para mostrar tu estado, tu recuperación y tus entrenamientos en el reloj."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN reads your Apple Health data to show your status, recovery and workouts on your watch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN läser dina data från Apple Health för att visa ditt tillstånd, din återhämtning och dina träningspass på klockan."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN guarda en Apple Health las carreras y salidas en bici que registras en el reloj."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN saves the runs and rides you record on the watch to Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN sparar löprundorna och cykelturerna du registrerar på klockan i Apple Hälsa."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN usa tu ubicación durante las carreras y salidas en bici al aire libre para medir distancia, ritmo, velocidad y ruta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN uses your location during outdoor runs and rides to measure distance, pace, speed and route."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN använder din plats under löprundor och cykelturer utomhus för att mäta distans, tempo, hastighet och rutt."
          }
        }
      }
    }
  },
  "version": "1.0"
}
