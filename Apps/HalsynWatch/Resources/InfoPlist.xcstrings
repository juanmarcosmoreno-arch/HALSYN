{
  "sourceLanguage": "es",
  "strings": {
    "NSHealthShareUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN lee tus datos de Apple Health para mostrar tu estado, tu recuperación y tus entrenamientos en el reloj."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN reads your Apple Health data to show your status, recovery and workouts on your watch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN läser dina data från Apple Health för att visa ditt tillstånd, din återhämtning och dina träningspass på klockan."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN guarda en Apple Health las carreras que registras en el reloj."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN saves the runs you record on your watch to Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN sparar löppassen som du registrerar på klockan i Apple Health."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN usa tu ubicación durante las carreras al aire libre para medir distancia, ritmo y ruta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN uses your location during outdoor runs to measure distance, pace and route."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN använder din plats under löppass utomhus för att mäta distans, tempo och rutt."
          }
        }
      }
    }
  },
  "version": "1.0"
}
