{
  "sourceLanguage": "es",
  "strings": {
    "NSHealthShareUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN lee tus datos de Apple Health para mostrar tu estado, tu recuperación y tus entrenamientos en el reloj."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN reads your Apple Health data to show your status, recovery and workouts on your watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HÅLSYN lê seus dados do Apple Health para mostrar seu estado, sua recuperação e seus treinos no relógio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN lit tes données Apple Health pour afficher ton état, ta récupération et tes entraînements sur la montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN legge i tuoi dati di Apple Health per mostrare il tuo stato, il tuo recupero e i tuoi allenamenti sull’orologio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN läser dina data från Apple Health för att visa ditt tillstånd, din återhämtning och dina träningspass på klockan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN læser dine data fra Apple Health for at vise din tilstand, din restitution og din træning på uret."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN 会读取你的 Apple Health 数据，以便在手表上显示你的状态、恢复情况和训练。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी पर आपकी स्थिति, रिकवरी और वर्कआउट दिखाने के लिए HÅLSYN आपका Apple Health डेटा पढ़ता है।"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN guarda en Apple Health las carreras que registras en el reloj."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN saves the runs you record on your watch to Apple Health."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HÅLSYN salva no Apple Health as corridas que você registra no relógio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN enregistre dans Apple Health les courses que tu enregistres sur la montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN salva in Apple Health le corse che registri con l’orologio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN sparar löppassen som du registrerar på klockan i Apple Health."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN gemmer de løbeture, du registrerer på uret, i Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN 会将你在手表上记录的跑步保存到 Apple Health。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप घड़ी पर जो रन रिकॉर्ड करते हैं, HÅLSYN उन्हें Apple Health में सेव करता है।"
          }
        }
      }
    }
  },
  "version": "1.0"
}
