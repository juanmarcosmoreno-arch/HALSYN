    "HRV muy por encima de lo habitual. Puede ser buena señal, pero a veces acompaña a cansancio acumulado: por eso no suma más que un valor algo alto.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV well above usual. It can be a good sign, but it sometimes comes with accumulated fatigue: that is why it adds no more than a moderately high value."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV långt över det vanliga. Det kan vara ett gott tecken men följer ibland med ackumulerad trötthet: därför räknas det inte mer än ett något högt värde."
          }
        }
      }
    },
    "HRV por debajo de tu basal %@ de los últimos 7 días.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV below your baseline on %@ of the last 7 days."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV under din baslinje %@ av de senaste 7 dagarna."
          }
        }
      }
    },
