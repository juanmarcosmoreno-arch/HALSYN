    "Resumen orientativo basado solo en tus datos disponibles. No es una valoración médica.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An approximate summary based only on your available data. It's not a medical assessment."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumo aproximado baseado apenas nos seus dados disponíveis. Não é uma avaliação médica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumé indicatif basé uniquement sur tes données disponibles. Ce n’est pas une évaluation médicale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riepilogo indicativo basato solo sui tuoi dati disponibili. Non è una valutazione medica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vägledande sammanfattning som bara bygger på dina tillgängliga data. Det är ingen medicinsk bedömning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vejledende oversigt, der kun bygger på dine tilgængelige data. Det er ikke en medicinsk vurdering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅基于你现有数据的参考性摘要。并非医疗评估。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल आपके उपलब्ध डेटा पर आधारित सांकेतिक सारांश। यह कोई चिकित्सकीय आकलन नहीं है।"
          }
        }
      }
    },
