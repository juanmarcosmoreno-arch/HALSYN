    "Nada destacable: no hay cambios por encima de los umbrales que usa HÅLSYN para decir algo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing notable: no changes above the thresholds HÅLSYN uses to say something."
          }
        },
        "sv": {
