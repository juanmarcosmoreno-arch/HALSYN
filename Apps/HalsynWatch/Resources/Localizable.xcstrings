    "Latidos por minuto medidos por el sensor óptico del Apple Watch a lo largo del día.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beats per minute measured by the Apple Watch optical sensor throughout the day."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Batimentos por minuto medidos pelo sensor óptico do Apple Watch ao longo do dia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Battements par minute mesurés par le capteur optique de l’Apple Watch tout au long de la journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Battiti al minuto misurati dal sensore ottico di Apple Watch nel corso della giornata."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slag per minut uppmätta av den optiska sensorn i Apple Watch under dagen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slag pr. minut målt af den optiske sensor i Apple Watch i løbet af dagen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
