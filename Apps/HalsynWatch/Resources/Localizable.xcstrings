    "Anoche dormiste %@, dentro de lo recomendado.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last night you slept %@, within the recommended range."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontem à noite você dormiu %@, dentro do recomendado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette nuit, tu as dormi %@, dans la plage recommandée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanotte hai dormito %@, entro i valori consigliati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I natt sov du %@, inom det rekommenderade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I nat sov du %@, inden for det anbefalede."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你昨晚睡了 %@，处于推荐范围内。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कल रात आप %@ सोए, जो सुझाई गई सीमा के भीतर है।"
          }
        }
      }
    },
    "Anoche dormiste %@, fuera del rango recomendado de 7–9 h.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last night you slept %@, outside the recommended 7–9 h range."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontem à noite você dormiu %@, fora da faixa recomendada de 7–9 h."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette nuit, tu as dormi %@, en dehors de la plage recommandée de 7 à 9 h."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanotte hai dormito %@, fuori dall’intervallo consigliato di 7–9 h."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I natt sov du %@, utanför det rekommenderade intervallet på 7–9 h."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I nat sov du %@, uden for det anbefalede interval på 7–9 t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你昨晚睡了 %@，不在 7–9 小时的推荐范围内。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कल रात आप %@ सोए, जो 7–9 h की सुझाई गई सीमा से बाहर है।"
          }
        }
      }
    },
