          }
        }
      }
    },
    "Tiempo, ritmo, frecuencia cardíaca y zona. El editor para elegir campos, orden y distribución llega en la Fase 5.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time, pace, heart rate and zone. The editor for choosing fields, order and layout arrives in Phase 5."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo, ritmo, frequência cardíaca e zona. O editor para escolher campos, ordem e disposição chega na Fase 5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée, allure, fréquence cardiaque et zone. L’éditeur pour choisir les champs, l’ordre et la disposition arrive lors de la Phase 5."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
