    "El motor de entrenamiento (sesión de HealthKit, GPS, ritmo, pausa y guardado) se implementa en la Fase 4 y debe validarse en un Apple Watch físico. En esta fase no se registra ningún entrenamiento.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout engine (HealthKit session, GPS, pace, pause and saving) is implemented in Phase 4 and must be validated on a physical Apple Watch. No workouts are recorded in this phase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor de treino (sessão do HealthKit, GPS, ritmo, pausa e salvamento) será implementado na Fase 4 e precisa ser validado em um Apple Watch físico. Nesta fase, nenhum treino é registrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur d’entraînement (session HealthKit, GPS, allure, pause et enregistrement) sera mis en place lors de la Phase 4 et devra être validé sur une Apple Watch physique. À ce stade, aucun entraînement n’est enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore di allenamento (sessione HealthKit, GPS, ritmo, pausa e salvataggio) verrà implementato nella Fase 4 e dovrà essere convalidato su un Apple Watch fisico. In questa fase non viene registrato alcun allenamento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Träningsmotorn (HealthKit-session, GPS, tempo, paus och sparande) införs i Fas 4 och måste valideras på en fysisk Apple Watch. I den här fasen registreras inga träningspass."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træningsmotoren (HealthKit-session, GPS, tempo, pause og lagring) implementeres i Fase 4 og skal valideres på et fysisk Apple Watch. I denne fase registreres der ingen træning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练引擎（HealthKit 会话、GPS、配速、暂停和保存）将在第 4 阶段实现，并需在实体 Apple Watch 上验证。本阶段不会记录任何训练。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्कआउट इंजन (HealthKit सेशन, GPS, पेस, पॉज़ और सेव) चरण 4 में लागू होगा और इसे असली Apple Watch पर जांचना ज़रूरी है। इस चरण में कोई वर्कआउट रिकॉर्ड नहीं होता।"
          }
        }
      }
    },
    "El motor de recuperación (RecoveryEngine) llega en la Fase 6.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery engine (RecoveryEngine) arrives in Phase 6."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor de recuperação (RecoveryEngine) chega na Fase 6."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de récupération (RecoveryEngine) arrive lors de la Phase 6."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore di recupero (RecoveryEngine) arriva nella Fase 6."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återhämtningsmotorn (RecoveryEngine) kommer i Fas 6."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Restitutionsmotoren (RecoveryEngine) kommer i Fase 6."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复引擎（RecoveryEngine）将在第 6 阶段推出。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकवरी इंजन (RecoveryEngine) चरण 6 में आएगा।"
          }
        }
      }
    },
