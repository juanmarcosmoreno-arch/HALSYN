    "Descanso, sueño y agua. Si mañana las señales vuelven a tu rango, retoma poco a poco.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest, sleep and water. If your signals are back in your range tomorrow, ease back in gradually."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vila, sömn och vatten. Om signalerna är tillbaka i ditt intervall i morgon kan du gradvis komma igång igen."
          }
        }
      }
    },
