    "No entra en el cálculo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not included in the calculation."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingår inte i beräkningen."
          }
        }
      }
    },
    "No entra en el cálculo: el registro de anoche es muy corto frente a lo habitual y parece incompleto (por ejemplo, el reloj sin batería).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not included: last night's record is very short compared with usual and looks incomplete (for example, the watch ran out of battery)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingår inte: nattens registrering är mycket kort jämfört med vanligt och ser ofullständig ut (till exempel att klockans batteri tog slut)."
          }
        }
      }
    },
    "No es un diagnóstico ni sustituye una valoración médica. Tus datos escritos se guardan solo en este iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a diagnosis and doesn't replace a medical assessment. The data you enter is stored only on this iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är ingen diagnos och ersätter inte en medicinsk bedömning. Uppgifterna du fyller i sparas bara på den här iPhonen."
          }
        }
      }
    },
    "No es un duplicado: contar los dos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a duplicate: count both"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte en dubblett: räkna båda"
          }
        }
      }
    },
    "No fue a tope: no usarlo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It wasn't all-out: don't use it"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var inte max: använd inte"
          }
        }
      }
    },
    "No fue a tope: no usarlo para el VDOT": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It wasn't all-out: don't use it for VDOT"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var inte max: använd inte för VDOT"
          }
        }
      }
    },
    "No guardar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't save"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara inte"
          }
        }
      }
    },
    "No había nada para restaurar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was nothing to restore."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det fanns inget att återställa."
          }
        }
      }
    },
    "No había pulso en los últimos segundos: no se midió la recuperación.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was no heart rate in the last seconds: recovery wasn't measured."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det fanns ingen puls under de sista sekunderna: återhämtningen mättes inte."
          }
        }
      }
    },
    "No hay cambios ni patrones claros en tus datos. Es normal: INSIKT solo habla cuando la diferencia es real.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no clear changes or patterns in your data. That's normal: INSIKT only speaks up when the difference is real."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inga tydliga förändringar eller mönster i dina data. Det är helt normalt: INSIKT säger bara något när skillnaden är verklig."
          }
        }
      }
    },
    "No hay datos de esa hora.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no data for that hour."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inga data för den timmen."
          }
        }
      }
    },
    "No hay informes. Si la app se traba o se cierra, iOS lo informa la próxima vez que la abres (a veces hasta un día después).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reports. If the app hangs or crashes, iOS reports it the next time you open it (sometimes up to a day later)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga rapporter. Om appen låser sig eller kraschar rapporterar iOS det nästa gång du öppnar den (ibland upp till ett dygn senare)."
          }
        }
      }
    },
    "No hay nada para revisar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to review"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget att granska"
          }
        }
      }
    },
    "No hay ningún Apple Watch emparejado.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Apple Watch is paired."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Apple Watch är parkopplad."
          }
        }
      }
    },
    "No hay una FC máxima introducida válida: se usa la validada.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no valid max HR entered: the validated one is used."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen giltig inmatad maxpuls: den validerade används."
          }
        }
      }
    },
    "No hecha": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not done"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte gjord"
          }
        }
      }
    },
    "No hechas": {
      "extractionState": "manual",
      "localizations": {
