    "Cumplimiento usado (sesiones y frecuencia frente a lo programado; con pocas sesiones, mezclado con el supuesto del 85 %): %@ → factor %@. Frecuencia del plan → factor %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adherence used (sessions and frequency versus what was scheduled; with few sessions, blended with the 85 % assumption): %@ → factor %@. Plan frequency → factor %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följsamhet som används (pass och frekvens mot det schemalagda; med få pass blandat med antagandet 85 %): %@ → faktor %@. Planens frekvens → faktor %@."
          }
        }
      }
    },
