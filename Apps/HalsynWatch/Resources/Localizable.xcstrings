    "Es una estimación de bienestar, no una valoración clínica, y no está validada en estudios.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a wellbeing estimate, not a clinical assessment, and it hasn't been validated in studies."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É uma estimativa de bem-estar, não uma avaliação clínica, e não foi validada em estudos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est une estimation de bien-être, pas une évaluation clinique, et elle n’a pas été validée par des études."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una stima di benessere, non una valutazione clinica, e non è stata validata da studi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är en uppskattning av välmående, inte en klinisk bedömning, och den är inte validerad i studier."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er et estimat af velvære, ikke en klinisk vurdering, og det er ikke valideret i undersøgelser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一项健康状况估算，并非临床评估，也未经研究验证。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सेहत का एक अनुमान है, कोई क्लिनिकल आकलन नहीं, और अध्ययनों में इसकी पुष्टि नहीं हुई है।"
          }
        }
      }
    },
