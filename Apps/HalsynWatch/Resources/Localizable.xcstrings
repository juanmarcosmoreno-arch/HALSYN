      }
    },
    "Hacen falta al menos 3 carreras al aire libre con GPS y pulso en el período, con tramos a ritmo estable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least 3 outdoor runs with GPS and heart rate are needed in the period, with steady-pace stretches."
          }
        },
