    "Incertidumbre de la proyección (VDOT, 1 desviación): %@ = raíz de la suma de varianzas: %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projection uncertainty (VDOT, 1 SD): %@ = square root of the sum of variances: %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognosens osäkerhet (VDOT, 1 standardavvikelse): %@ = roten ur summan av varianserna: %@."
          }
        }
      }
    },
    "Inclinación": {
