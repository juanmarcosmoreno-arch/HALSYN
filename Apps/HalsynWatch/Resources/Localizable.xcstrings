    "Zonas aproximadas: salen de la FC más alta registrada, y tu máxima real puede ser mayor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate zones: they come from your highest recorded heart rate, and your real maximum may be higher."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungefärliga zoner: de bygger på din högsta registrerade puls, och din verkliga maxpuls kan vara högre."
          }
        }
      }
    },
    "Zonas aproximadas: salen de la FC más alta repetida en tus carreras, y tu máxima real puede ser mayor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate zones: they come from the highest HR repeated in your runs, and your real max may be higher."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungefärliga zoner: de kommer från den högsta pulsen som upprepats i dina löppass, och din verkliga maxpuls kan vara högre."
          }
        }
      }
    },
    "Zonas cardíacas": {
      "extractionState": "manual",
      "localizations": {
