        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Industrisötsaker: godis, bakverk, kakor eller tårtor"
          }
        }
      }
    },
    "Duplicado de otro resultado del mismo día: cuenta una sola vez. Mantén pulsado para borrarlo o para marcar que no es un duplicado.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate of another result on the same day: it counts once. Touch and hold to delete it or to mark that it isn't a duplicate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubblett av ett annat resultat samma dag: räknas en gång. Håll intryckt för att radera det eller markera att det inte är en dubblett."
          }
        }
      }
    },
    "Duplicado: el mismo entrenamiento está dos veces": {
      "extractionState": "manual",
