          }
        }
      }
    },
    "Sesgo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bias"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systematiskt fel"
          }
        }
      }
    },
    "Sesgo positivo: el modelo te ve más lento de lo que corres (pesimista); negativo: optimista. Un rango bien calibrado contiene cerca del 80 % de los tiempos reales.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive bias: the model sees you slower than you run (pessimistic); negative: optimistic. A well-calibrated range contains about 80 % of real times."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Positivt systematiskt fel: modellen tror att du är långsammare än du springer (pessimistisk); negativt: optimistisk. Ett välkalibrerat intervall innehåller ungefär 80 % av de verkliga tiderna."
          }
        }
      }
    },
    "Sesiones %@ · %@ de %@ carreras por semana": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions %@ · %@ of %@ runs per week"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass %@ · %@ av %@ löppass per vecka"
          }
        }
      }
    },
