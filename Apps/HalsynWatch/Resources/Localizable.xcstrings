        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly monotony: %@ (strain %@). There's variety between hard and easy days."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Veckans monotoni: %@ (strain %@). Det finns variation mellan hårda och lätta dagar."
          }
        }
      }
    },
    "Monotonía de la semana: %@, alta (strain %@). Tus días se parecen mucho entre sí: alternar días duros y suaves ayuda a asimilar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly monotony: %@, high (strain %@). Your days are very similar: alternating hard and easy days helps you absorb training."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Veckans monotoni: %@, hög (strain %@). Dina dagar är väldigt lika: att växla mellan hårda och lätta dagar hjälper dig att tillgodogöra dig träningen."
          }
