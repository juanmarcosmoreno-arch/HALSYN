    "%@ frente a tu media semanal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vs. your weekly average"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ em relação à sua média semanal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par rapport à ta moyenne hebdomadaire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rispetto alla tua media settimanale"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jämfört med ditt veckosnitt"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ i forhold til dit ugentlige gennemsnit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较每周平均 %@"
