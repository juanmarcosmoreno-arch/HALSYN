    "Porcentaje de oxígeno en sangre estimado por el reloj en modelos compatibles. No sirve para uso médico.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood oxygen percentage estimated by the watch on compatible models. Not intended for medical use."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Porcentagem de oxigênio no sangue estimada pelo relógio em modelos compatíveis. Não serve para uso médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourcentage d’oxygène dans le sang estimé par la montre sur les modèles compatibles. Ne convient pas à un usage médical."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentuale di ossigeno nel sangue stimata dall’orologio sui modelli compatibili. Non è adatta a un uso medico."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Andel syre i blodet, uppskattad av klockan på kompatibla modeller. Inte avsedd för medicinskt bruk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Procentdel ilt i blodet, estimeret af uret på kompatible modeller. Ikke til medicinsk brug."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容型号手表估算的血氧百分比。不可用于医疗用途。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संगत मॉडलों पर घड़ी द्वारा अनुमानित रक्त में ऑक्सीजन का प्रतिशत। यह चिकित्सकीय उपयोग के लिए नहीं है।"
          }
        }
      }
    },
