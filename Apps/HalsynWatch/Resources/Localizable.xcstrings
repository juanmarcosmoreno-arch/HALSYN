    "Súbete a la balanza descalzo. HÅLSYN la escucha por Bluetooth: no hace falta emparejarla ni abrir Zepp Life.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step on the scale barefoot. HÅLSYN listens to it over Bluetooth: no need to pair it or open Zepp Life."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliv på vågen barfota. HÅLSYN lyssnar på den via Bluetooth: du behöver inte parkoppla den eller öppna Zepp Life."
          }
        }
      }
    },
