    "Acostado, empuja con el talón y sube la cadera sin arquear la espalda. Con peso, hip thrust.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying down, push through your heel and lift your hips without arching your back. With weight, it's a hip thrust."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liggande, tryck genom hälen och lyft höften utan att svanka. Med vikt blir det hip thrust."
          }
        }
      }
    },
