    "iOS te mostrará la lista de datos. Puedes activar solo los que quieras: HÅLSYN funcionará con lo que compartas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS will show you the list of data. You can turn on only the ones you want: HÅLSYN will work with whatever you share."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS mostrará a lista de dados. Você pode ativar apenas os que quiser: o HÅLSYN funcionará com o que você compartilhar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS va t’afficher la liste des données. Tu peux activer uniquement celles que tu veux : HÅLSYN fonctionnera avec ce que tu partages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ti mostrerà l’elenco dei dati. Puoi attivare solo quelli che vuoi: HÅLSYN funzionerà con ciò che condividi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS visar en lista över data. Du kan aktivera bara de du vill – HÅLSYN fungerar med det du delar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS viser dig en liste over data. Du kan slå kun dem til, du vil – HÅLSYN fungerer med det, du deler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会显示数据列表。你可以只开启想共享的项目：HÅLSYN 会使用你共享的数据运行。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS आपको डेटा की सूची दिखाएगा। आप सिर्फ़ वही चालू कर सकते हैं जो आप चाहें: HÅLSYN आपके शेयर किए गए डेटा के साथ काम करेगा।"
          }
        }
      }
    },
