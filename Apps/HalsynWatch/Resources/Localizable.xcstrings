    "Lleva el Apple Watch al dormir para ver tu descanso.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wear your Apple Watch to sleep to see your rest."
          }
        },
        "pt-BR": {
