            "state": "translated",
            "value": "Delete goal"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera mål"
          }
        }
      }
    },
    "Empezando": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting started"
          }
        },
        "sv": {
