          }
        }
      }
    },
    "Sesión intensa hace unas %@ h: el cuerpo puede seguir recuperándose aunque las señales de la mañana sean buenas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard session about %@ h ago: your body may still be recovering even if the morning signals look good."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hårt pass för ungefär %@ h sedan: kroppen kan fortfarande återhämta sig även om morgonens signaler är bra."
          }
        }
      }
    },
