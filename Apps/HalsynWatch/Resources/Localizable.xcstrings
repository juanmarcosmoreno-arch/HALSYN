    "Tu VDOT de %@ es una media ponderada de %lld pruebas: (%@) ÷ %@. Por eso no coincide con el VDOT de ninguna prueba en particular.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your VDOT of %@ is a weighted mean of %lld results: (%@) ÷ %@. That's why it doesn't match the VDOT of any single result."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt VDOT på %@ är ett viktat medelvärde av %lld resultat: (%@) ÷ %@. Därför stämmer det inte med VDOT för något enskilt resultat."
          }
        }
      }
    },
