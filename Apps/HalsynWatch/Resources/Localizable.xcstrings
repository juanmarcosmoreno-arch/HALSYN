    "Indicador indirecto: velocidad por cada vatio. No mide la economía de carrera real, que necesita análisis de gases.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirect indicator: speed per watt. It does not measure true running economy, which requires gas analysis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirekt mått: fart per watt. Det mäter inte verklig löpekonomi, som kräver gasanalys."
          }
        }
      }
    },
    "Indicador orientativo, no un diagnóstico.": {
