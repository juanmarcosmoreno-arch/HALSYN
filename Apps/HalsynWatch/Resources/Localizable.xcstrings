    },
    "Ahora mismo HÅLSYN muestra datos sintéticos de demostración. La lectura real de Apple Health, con permisos granulares, se implementa en la Fase 2.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right now HÅLSYN shows synthetic demo data. Reading real Apple Health data, with granular permissions, is implemented in Phase 2."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No momento, o HÅLSYN mostra dados sintéticos de demonstração. A leitura real do Apple Health, com permissões granulares, será implementada na Fase 2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l’instant, HÅLSYN affiche des données de démonstration synthétiques. La lecture réelle d’Apple Health, avec des autorisations détaillées, sera mise en place lors de la Phase 2."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento HÅLSYN mostra dati dimostrativi sintetici. La lettura reale di Apple Health, con autorizzazioni dettagliate, verrà implementata nella Fase 2."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Just nu visar HÅLSYN syntetiska demodata. Den riktiga läsningen från Apple Health, med detaljerade behörigheter, införs i Fas 2."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lige nu viser HÅLSYN syntetiske demodata. Den rigtige læsning fra Apple Health, med detaljerede tilladelser, implementeres i Fase 2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN 目前显示的是合成演示数据。在第 2 阶段中，将实现通过精细权限读取真实的 Apple Health 数据。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी HÅLSYN सिंथेटिक डेमो डेटा दिखा रहा है। विस्तृत अनुमतियों के साथ Apple Health का असली डेटा पढ़ने की सुविधा चरण 2 में जोड़ी जाएगी।"
          }
        }
      }
    },
