            "value": "Live time, distance, pace and heart rate from your Apple Watch, even without your iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo, distância, ritmo e frequência cardíaca ao vivo no seu Apple Watch, mesmo sem o iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée, distance, allure et fréquence cardiaque en direct depuis ton Apple Watch, même sans l’iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo, distanza, ritmo e frequenza cardiaca in tempo reale dal tuo Apple Watch, anche senza iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid, distans, tempo och puls i realtid från din Apple Watch, även utan iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid, distance, tempo og puls direkte fra dit Apple Watch, også uden iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在 Apple Watch 上实时显示时间、距离、配速和心率，即使不带 iPhone 也可以。"
          }
