    },
    "Esta semana": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här veckan"
          }
        }
      }
    },
    "Esta semana alcanzaste tu objetivo todas las noches registradas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week you reached your goal every recorded night."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I veckan nådde du ditt mål alla registrerade nätter."
          }
        }
      }
    },
    "Esta semana dormiste menos de 6 h en %lld noches. Varias noches cortas seguidas suelen acompañar a una recuperación más baja; si se repite, conviene priorizar el descanso.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week you slept under 6 h on %lld nights. Several short nights in a row often come with lower recovery; if it continues, prioritize rest."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här veckan sov du under 6 h %lld nätter. Flera korta nätter i rad brukar följas av lägre återhämtning; om det fortsätter, prioritera vila."
          }
        }
      }
    },
    "Esta semana la carga subió mucho frente a tu habitual.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week your load rose a lot compared with your usual."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här veckan ökade belastningen mycket jämfört med din vanliga."
          }
        }
      }
    },
    "Esta semana te faltaron %@ respecto a tu objetivo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week you were %@ short of your goal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I veckan saknades %@ till ditt mål."
          }
        }
      }
    },
    "Estabilidad del volumen": {
