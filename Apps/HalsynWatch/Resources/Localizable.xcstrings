    "Límites: %@. Los rangos son orientativos: no están calibrados con tus resultados reales. Daniels y Riegel son fórmulas de población; tu respuesta puede ser distinta.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits: %@. The ranges are indicative: they aren't calibrated with your real results. Daniels and Riegel are population formulas; your response may differ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begränsningar: %@. Intervallen är vägledande: de är inte kalibrerade mot dina verkliga resultat. Daniels och Riegel är befolkningsformler; din respons kan skilja sig."
          }
        }
      }
    },
