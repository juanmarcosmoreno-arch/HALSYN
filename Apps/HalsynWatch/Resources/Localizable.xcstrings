      }
    },
    "Los cambios se envían al Apple Watch automáticamente.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes are sent to your Apple Watch automatically."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar skickas automatiskt till din Apple Watch."
          }
        }
      }
    },
    "Los cambios valen para esta semana. Las siguientes se reajustan cada lunes con lo que corriste.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply to this week. The following weeks are readjusted every Monday based on what you ran."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringarna gäller den här veckan. Följande veckor justeras varje måndag utifrån det du sprungit."
          }
        }
      }
    },
    "Los métodos difieren más de un 3 %: la predicción es menos segura.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The methods differ by more than 3 %: the prediction is less certain."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Metoderna skiljer sig med mer än 3 %: prognosen är mindre säker."
          }
        }
      }
    },
    "Los nombres de los módulos son palabras suecas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The module names are Swedish words."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modulernas namn är svenska ord."
          }
        }
      }
    },
    "Los objetivos se guardan solo en este iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goals are stored only on this iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Målen sparas bara på den här iPhonen."
          }
        }
      }
    },
    "Los permisos de cada tipo de dato se cambian en Ajustes › Salud › Acceso a datos y dispositivos › HÅLSYN. iOS no informa a las apps de qué datos se han denegado.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions for each data type are changed in Settings › Health › Data Access & Devices › HÅLSYN. iOS doesn't tell apps which data has been denied."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behörigheter för varje datatyp ändrar du i Inställningar › Hälsa › Dataåtkomst och enheter › HÅLSYN. iOS talar inte om för appar vilka data som har nekats."
          }
        }
      }
    },
    "Los rangos son orientativos del modelo: todavía no se comprobaron con tus resultados reales, así que no garantizan un 80 % de acierto.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ranges are the model's indicative ranges: they haven't been checked against your real results yet, so they don't guarantee 80 % accuracy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervallen är modellens vägledande intervall: de har ännu inte kontrollerats mot dina verkliga resultat, så de garanterar inte 80 % träffsäkerhet."
          }
        }
      }
    },
    "Los rangos ya se comprobaron con tus propios resultados.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ranges have been checked against your own results."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervallen har kontrollerats mot dina egna resultat."
          }
        }
      }
    },
