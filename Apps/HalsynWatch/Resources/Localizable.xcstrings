      }
    },
    "No hechas por enfermedad o lesión (no cuentan)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not done due to illness or injury (don't count)"
          }
        },
        "sv": {
