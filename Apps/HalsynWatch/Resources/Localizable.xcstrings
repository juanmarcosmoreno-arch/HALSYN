    "Abre los ajustes de la app para cambiar el idioma": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app settings to change the language"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra os ajustes do app para mudar o idioma"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les réglages de l’app pour changer de langue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri le impostazioni dell’app per cambiare lingua"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna appens inställningar för att byta språk"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn appens indstillinger for at skifte sprog"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 App 设置以更改语言"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा बदलने के लिए ऐप की सेटिंग खोलें"
          }
        }
      }
    },
