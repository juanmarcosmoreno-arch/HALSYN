        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ min träning de senaste 7 dagarna (riktvärde: 150)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ min motion de seneste 7 dage (pejlemærke: 150)"
