    "Frescura negativa: al terminar ayer tu fatiga (media de 7 días) superaba tu forma física (media de 42 días).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Negative freshness: at the end of yesterday your fatigue (7-day average) was above your fitness (42-day average)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Negativ fräschhet: vid slutet av gårdagen låg din trötthet (7-dagarsmedel) över din form (42-dagarsmedel)."
          }
        }
      }
    },
    "Frescura neutra: al terminar ayer tu fatiga y tu forma física estaban igualadas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neutral freshness: at the end of yesterday your fatigue and your fitness were even."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neutral fräschhet: vid slutet av gårdagen var din trötthet och din form lika."
          }
        }
      }
    },
    "Frescura positiva: al terminar ayer tu fatiga (media de 7 días) estaba por debajo de tu forma física (media de 42 días).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive freshness: at the end of yesterday your fatigue (7-day average) was below your fitness (42-day average)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Positiv fräschhet: vid slutet av gårdagen låg din trötthet (7-dagarsmedel) under din form (42-dagarsmedel)."
          }
        }
      }
    },
