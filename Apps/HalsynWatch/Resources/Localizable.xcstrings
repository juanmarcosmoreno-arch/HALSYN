          }
        }
      }
    },
    "Llevas %@ min de ejercicio en los últimos 7 días (referencia: 150).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've done %@ min of exercise in the last 7 days (reference: 150)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você fez %@ min de exercício nos últimos 7 dias (referência: 150)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as fait %@ min d’exercice sur les 7 derniers jours (référence : 150)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai fatto %@ min di esercizio negli ultimi 7 giorni (riferimento: 150)."
          }
        },
        "sv": {
