    "100 entre 7 y 9 h, la recomendación de la AASM y la SRS para adultos. Baja hasta 0 a las 4 h; dormir más de 9 h casi no resta (mínimo 70).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100 between 7 and 9 h, the AASM and SRS recommendation for adults. It drops to 0 at 4 h; sleeping more than 9 h barely takes any points away (minimum 70)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "100 mellan 7 och 9 h, AASM:s och SRS:s rekommendation för vuxna. Sjunker till 0 vid 4 h; att sova mer än 9 h drar nästan inte av något (minst 70)."
          }
        }
      }
    },
    "150 min de actividad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "150 min of activity"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "150 min aktivitet"
          }
        }
      }
    },
    "150 min semanales de actividad moderada es la recomendación de la OMS para adultos; 7–9 h de sueño, la recomendación general para adultos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "150 min of moderate activity per week is the WHO recommendation for adults; 7–9 h of sleep is the general recommendation for adults."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "150 min måttlig aktivitet per vecka är WHO:s rekommendation för vuxna; 7–9 h sömn är den allmänna rekommendationen för vuxna."
          }
        }
      }
    },
