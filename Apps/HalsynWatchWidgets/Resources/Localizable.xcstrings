    "Usa la media de varias mediciones, sentado y tras 5 minutos de reposo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the average of several readings, taken sitting down after 5 minutes of rest."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd medelvärdet av flera mätningar, sittande och efter 5 minuters vila."
          }
        }
      }
    },
