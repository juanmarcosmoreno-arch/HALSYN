    "Sin diabetes: ayunas <100 mg/dL (o HbA1c <5,7) 100 · 100–125 (5,7–6,4) 60. Con diabetes, HbA1c: <7: 40 · 7–7,9: 30 · 8–8,9: 20 · 9–9,9: 10 · ≥10: 0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without diabetes: fasting <100 mg/dL (or HbA1c <5.7) 100 · 100–125 (5.7–6.4) 60. With diabetes, HbA1c: <7: 40 · 7–7.9: 30 · 8–8.9: 20 · 9–9.9: 10 · ≥10: 0"
          }
        },
        "sv": {
          "stringUnit": {
