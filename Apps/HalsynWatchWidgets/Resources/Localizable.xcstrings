    "Con 3 carreras de 3 km o más en los últimos 90 días, HÅLSYN estima tus tiempos para 5 km, 10 km, media maratón y maratón.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With 3 runs of 3 km or more in the last 90 days, HÅLSYN estimates your times for the 5K, 10K, half marathon and marathon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med 3 löppass på minst 3 km under de senaste 90 dagarna uppskattar HÅLSYN dina tider på 5 km, 10 km, halvmaraton och maraton."
          }
        }
      }
    },
