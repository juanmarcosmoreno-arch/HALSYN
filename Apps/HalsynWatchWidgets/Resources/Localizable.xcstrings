    "Llegarás a la meta en %lld semanas, subiendo como mucho un 10 por ciento por semana.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll reach the target in %lld weeks, increasing by no more than 10 percent per week."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du når målnivån om %lld veckor, med en ökning på högst 10 procent per vecka."
          }
        }
      }
    },
    "Llegaste a tu objetivo en %lld de %lld noches.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You reached your goal on %lld of %lld nights."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nådde ditt mål %lld av %lld nätter."
          }
        }
      }
    },
    "Lleva el Apple Watch al dormir (o usa otra app que guarde el sueño en Salud) para ver tus noches aquí.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wear your Apple Watch to sleep (or use another app that saves sleep to Health) to see your nights here."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bär Apple Watch när du sover (eller använd en annan app som sparar sömn i Hälsa) för att se dina nätter här."
          }
        }
      }
    },
    "Lleva el Apple Watch al dormir para ver tu descanso.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
