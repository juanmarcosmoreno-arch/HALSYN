    "Usa el resultado de un test de 20 minutos (95 por ciento de la media), de un test en laboratorio o el que te dé otra app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the result of a 20-minute test (95 percent of the average), a lab test or the one another app gives you."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd resultatet från ett 20-minuterstest (95 procent av medelvärdet), ett laboratorietest eller det som en annan app ger dig."
          }
        }
      }
    },
    "Usa la media de varias mediciones, sentado y tras 5 minutos de reposo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the average of several readings, taken sitting down after 5 minutes of rest."
