    "Pide mejorar más rápido de lo habitual. Es posible, pero no lo des por hecho.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It requires improving faster than usual. It's possible, but don't take it for granted."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kräver snabbare förbättring än normalt. Det är möjligt, men ta det inte för givet."
          }
        }
      }
    },
    "Pide más del doble de la mejora habitual. Un objetivo cerca de %@ es más alcanzable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It requires more than twice the typical improvement. A goal around %@ is more achievable."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kräver mer än dubbelt så stor förbättring som normalt. Ett mål runt %@ är lättare att nå."
          }
        }
      }
    },
    "Pide una mejora dentro de lo habitual para las semanas que quedan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It requires a typical amount of improvement for the weeks remaining."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kräver en normal förbättring under de veckor som återstår."
          }
        }
      }
    },
    "Piensa en una semana normal. Indica cuántas raciones tomas de cada cosa, al día o a la semana. Si no lo comes nunca, deja 0.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think of a typical week. Enter how many servings you have of each item, per day or per week. If you never eat it, leave 0."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänk på en vanlig vecka. Ange hur många portioner du äter av varje sak, per dag eller per vecka. Om du aldrig äter det, lämna 0."
          }
        }
      }
    },
