    "Marca lo que hubo hoy. Con unas semanas, INSIKT te muestra cómo influye en tu sueño, tu HRV y tu pulso en reposo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap what happened today. After a few weeks, INSIKT shows you how it affects your sleep, HRV and resting HR."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera det som hände i dag. Efter några veckor visar INSIKT hur det påverkar din sömn, din HRV och din vilopuls."
          }
        }
      }
    },
