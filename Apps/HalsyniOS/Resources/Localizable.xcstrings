    "Edad y sexo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age and sex"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ålder och kön"
          }
        }
      }
    },
    "Edad y sexo biológico solo se usan para compararte con tablas científicas publicadas (VO₂ máx. y FC en reposo); la altura, para el IMC. Se guardan solo en este iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age and biological sex are only used to compare you with published scientific tables (VO₂ max and resting HR); height, for BMI. They're stored only on this iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ålder och biologiskt kön används bara för att jämföra dig med publicerade vetenskapliga tabeller (VO₂ max och vilopuls); längden för BMI. De sparas bara på den här iPhonen."
          }
        }
      }
    },
    "Editar": {
      "extractionState": "manual",
