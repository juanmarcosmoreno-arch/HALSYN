    "Esta balanza mide solo el peso (no tiene electrodos para la grasa).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This scale only measures weight (it has no electrodes for body fat)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här vågen mäter bara vikt (den har inga elektroder för kroppsfett)."
          }
        }
      }
    },
    "Esta fuente no registra fases del sueño.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source doesn't record sleep stages."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här källan registrerar inte sömnstadier."
          }
        }
      }
    },
    "Esta salida no tiene ruta GPS en Apple Health, o HÅLSYN no tiene permiso para leerla.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ride has no GPS route in Apple Health, or HÅLSYN isn't allowed to read it."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här cykelturen har ingen GPS-rutt i Apple Hälsa, eller så får HÅLSYN inte läsa den."
          }
        }
      }
    },
    "Esta semana alcanzaste tu objetivo todas las noches registradas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week you reached your goal every recorded night."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I veckan nådde du ditt mål alla registrerade nätter."
          }
        }
      }
    },
    "Esta semana te faltaron %@ respecto a tu objetivo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week you were %@ short of your goal."
          }
        },
        "sv": {
