    "Calculados a partir de la ruta GPS, sin contar las paradas largas; pueden diferir ligeramente de la distancia total de Apple Health.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated from the GPS route, excluding long stops; they may differ slightly from the total distance in Apple Health."
          }
        },
