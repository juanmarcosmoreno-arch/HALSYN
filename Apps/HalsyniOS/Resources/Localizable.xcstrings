          }
        }
      }
    },
    "Sin días marcados, todos los días. El aviso solo nombra el objetivo, nunca tus datos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With no days selected, every day. The notification only names the goal, never your data."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan valda dagar gäller alla dagar. Aviseringen nämner bara målet, aldrig dina data."
          }
        }
      }
    },
    "Sin envío de métricas a servicios de IA.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No metrics are sent to AI services."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga mätvärden skickas till AI-tjänster."
          }
        }
      }
    },
    "Sin impedancia (hay que subirse descalzo y con los pies secos): solo se guarda el peso.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No impedance (you need to step on barefoot with dry feet): only the weight is saved."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen impedans (du behöver kliva på barfota med torra fötter): bara vikten sparas."
          }
        }
      }
    },
    "Sin indicar": {
      "extractionState": "manual",
      "localizations": {
