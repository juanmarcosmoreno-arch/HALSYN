            "value": "Negative freshness: at the end of yesterday your fatigue (7-day average) was above your fitness (42-day average)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Negativ fräschhet: vid slutet av gårdagen låg din trötthet (7-dagarsmedel) över din form (42-dagarsmedel)."
          }
        }
      }
    },
    "Frescura neutra: al terminar ayer tu fatiga y tu forma física estaban igualadas.": {
      "extractionState": "manual",
