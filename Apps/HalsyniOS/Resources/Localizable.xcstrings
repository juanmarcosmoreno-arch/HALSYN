    "Hacen falta 10 mediciones que terminen con un pulso parecido para ver si tu recuperación cambia.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It takes 10 measurements ending at a similar heart rate to see whether your recovery is changing."
