    "Cuánto avanzas con cada latido. Si sube con el tiempo a ritmos parecidos, estás más en forma.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far you go with each heartbeat. If it rises over time at similar paces, you're getting fitter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur långt du kommer med varje hjärtslag. Om det ökar över tid vid liknande tempo kommer du i bättre form."
