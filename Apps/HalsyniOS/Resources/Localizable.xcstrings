      }
    },
    "Sistólica (máxima)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Systolic (upper)"
          }
        },
        "sv": {
          "stringUnit": {
