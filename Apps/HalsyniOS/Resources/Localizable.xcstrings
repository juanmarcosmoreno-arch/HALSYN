    "Sin tiempo objetivo: el plan te prepara para la distancia con tu forma actual.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No goal time: the plan prepares you for the distance at your current fitness."
          }
        },
