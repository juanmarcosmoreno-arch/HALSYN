    "Salud no ha compartido tu fecha de nacimiento, tu sexo ni tu altura. Puedes escribirlos aquí.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health hasn't shared your date of birth, sex or height. You can enter them here."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälsa har inte delat ditt födelsedatum, ditt kön eller din längd. Du kan ange dem här."
