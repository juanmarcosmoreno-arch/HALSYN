    "No es un diagnóstico ni sustituye una valoración médica. Tus datos escritos se guardan solo en este iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a diagnosis and doesn't replace a medical assessment. The data you enter is stored only on this iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är ingen diagnos och ersätter inte en medicinsk bedömning. Uppgifterna du fyller i sparas bara på den här iPhonen."
          }
        }
      }
    },
    "No guardar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't save"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara inte"
          }
        }
      }
    },
    "No había pulso en los últimos segundos: no se midió la recuperación.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was no heart rate in the last seconds: recovery wasn't measured."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det fanns ingen puls under de sista sekunderna: återhämtningen mättes inte."
          }
        }
      }
    },
    "No hay cambios ni patrones claros en tus datos. Es normal: INSIKT solo habla cuando la diferencia es real.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no clear changes or patterns in your data. That's normal: INSIKT only speaks up when the difference is real."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inga tydliga förändringar eller mönster i dina data. Det är helt normalt: INSIKT säger bara något när skillnaden är verklig."
          }
        }
      }
    },
    "No hay ningún Apple Watch emparejado.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Apple Watch is paired."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Apple Watch är parkopplad."
          }
        }
      }
    },
    "No hubo lecturas del pulso cerca del minuto (¿la correa estaba floja?): no hay valor para guardar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There were no heart rate readings near the minute (was the band loose?): there's no value to save."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det fanns inga pulsvärden nära minuten (satt armbandet löst?): det finns inget värde att spara."
          }
        }
      }
    },
    "No medida": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not measured"
          }
        },
        "sv": {
