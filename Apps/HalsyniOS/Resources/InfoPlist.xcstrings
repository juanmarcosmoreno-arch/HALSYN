{
  "sourceLanguage": "es",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN usa Bluetooth para leer el peso de tu balanza Xiaomi mientras te pesas con la app abierta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN uses Bluetooth to read the weight from your Xiaomi scale while you weigh yourself with the app open."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN använder Bluetooth för att läsa vikten från din Xiaomi-våg medan du väger dig med appen öppen."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN lee tus datos de Apple Health (frecuencia cardíaca, HRV, sueño, actividad y entrenamientos) para mostrarte tu estado y tus tendencias. Los datos se procesan en tu dispositivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN reads your Apple Health data (heart rate, HRV, sleep, activity and workouts) to show you your status and trends. Your data is processed on your device."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN läser dina data från Apple Health (puls, HRV, sömn, aktivitet och träningspass) för att visa ditt tillstånd och dina trender. Data behandlas på din enhet."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN guarda en Apple Health los entrenamientos que registras con la app y el peso de tu balanza."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN saves the workouts you record with the app and your scale's weight to Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HÅLSYN sparar träningspassen du registrerar med appen och vikten från din våg i Apple Hälsa."
          }
        }
      }
    }
  },
  "version": "1.0"
}
