// Ajustes compartidos de HÅLSYN (iPhone, Apple Watch y tests).
//
// Equipo de firma y bundle ID del proyecto: los tres targets (iPhone, reloj y
// tests) se firman con el mismo equipo y `git pull` no los cambia.
// Otro desarrollador puede usar los suyos en Config/Local.xcconfig (ignorado
// por git; ver Config/Local.xcconfig.example), que tiene prioridad.

HALSYN_BUNDLE_ID = com.juanmarcos.halsyn
DEVELOPMENT_TEAM = 62395T6WLG

#include? "Local.xcconfig"
